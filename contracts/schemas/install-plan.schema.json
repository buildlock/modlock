{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modlock.invalid/v1/install-plan.schema.json",
  "title": "Signed install plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "resolution_id", "issued_at", "expires_at", "subject", "files", "warnings", "signature"],
  "properties": {
    "schema_version": { "const": 1 },
    "resolution_id": { "type": "string", "pattern": "^res_[A-Za-z0-9_-]{8,96}$" },
    "issued_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id", "version_id"],
      "properties": {
        "kind": { "type": "string", "enum": ["release", "pack"] },
        "id": { "type": "string", "maxLength": 96 },
        "version_id": { "type": "string", "maxLength": 96 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file_id", "source_kind", "name", "size", "download_url", "required"],
        "properties": {
          "file_id": { "type": "string", "maxLength": 96 },
          "source_kind": { "type": "string", "enum": ["modlock-hosted", "gamebanana-linked", "external-linked"] },
          "name": { "type": "string", "minLength": 1, "maxLength": 255 },
          "size": { "type": "integer", "minimum": 0, "maximum": 10737418240 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "download_url": { "type": "string", "format": "uri", "maxLength": 4096 },
          "canonical_page_url": { "type": ["string", "null"], "format": "uri" },
          "required": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 10000 },
          "variant": { "type": ["string", "null"], "maxLength": 64 },
          "scan_attestation_id": { "type": ["string", "null"], "maxLength": 96 }
        }
      }
    },
    "warnings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "message"],
        "properties": {
          "code": { "type": "string", "pattern": "^[A-Z0-9_]{3,64}$" },
          "severity": { "type": "string", "enum": ["info", "warning", "blocking"] },
          "message": { "type": "string", "maxLength": 1000 }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "key_id", "value"],
      "properties": {
        "algorithm": { "type": "string", "enum": ["ed25519"] },
        "key_id": { "type": "string", "maxLength": 96 },
        "value": { "type": "string", "minLength": 32, "maxLength": 512 }
      }
    }
  }
}

