{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modlock.invalid/v1/profile.schema.json",
  "title": "Portable Modlock profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "name", "entries", "created_at", "updated_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "profile_id": { "type": "string", "pattern": "^profile_[A-Za-z0-9_-]{8,64}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100 },
    "entries": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "source_kind", "release_or_remote_id", "enabled", "priority"],
        "properties": {
          "entry_id": { "type": "string", "maxLength": 96 },
          "source_kind": { "type": "string", "enum": ["modlock-hosted", "gamebanana-linked", "external-linked", "local"] },
          "release_or_remote_id": { "type": "string", "maxLength": 128 },
          "file_id": { "type": ["string", "null"], "maxLength": 128 },
          "variant": { "type": ["string", "null"], "maxLength": 64 },
          "object_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "enabled": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "cfg_preset_version_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 96 } },
    "crosshair_version_id": { "type": ["string", "null"], "maxLength": 96 },
    "extensions": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}

