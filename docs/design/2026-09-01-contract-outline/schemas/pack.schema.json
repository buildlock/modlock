{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modlock.invalid/v1/pack.schema.json",
  "title": "Immutable reference pack version",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "pack_id", "version_id", "version", "verification", "items", "created_at"],
  "properties": {
    "schema_version": { "const": 1 },
    "pack_id": { "type": "string", "pattern": "^pack_[A-Za-z0-9_-]{8,64}$" },
    "version_id": { "type": "string", "pattern": "^packv_[A-Za-z0-9_-]{8,64}$" },
    "version": { "type": "string", "minLength": 1, "maxLength": 64 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "verification": { "type": "string", "enum": ["creator-verified", "creator-contributed", "community-reported", "expired", "revoked"] },
    "approved_at": { "type": ["string", "null"], "format": "date-time" },
    "expires_at": { "type": ["string", "null"], "format": "date-time" },
    "tested_game_build": { "type": ["string", "null"], "maxLength": 64 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "source_kind", "release_or_remote_id", "required", "priority"],
        "properties": {
          "item_id": { "type": "string", "maxLength": 96 },
          "source_kind": { "type": "string", "enum": ["modlock-hosted", "gamebanana-linked", "external-linked"] },
          "release_or_remote_id": { "type": "string", "maxLength": 128 },
          "file_id": { "type": ["string", "null"], "maxLength": 128 },
          "variant": { "type": ["string", "null"], "maxLength": 64 },
          "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "required": { "type": "boolean" },
          "priority": { "type": "integer", "minimum": 0, "maximum": 10000 }
        }
      }
    },
    "source_evidence_urls": { "type": "array", "maxItems": 20, "items": { "type": "string", "format": "uri" } },
    "extensions": { "type": "object", "additionalProperties": true },
    "created_at": { "type": "string", "format": "date-time" }
  }
}

