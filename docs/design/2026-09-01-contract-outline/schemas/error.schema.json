{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.modlock.invalid/v1/error.schema.json",
  "title": "API error envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["error"],
  "properties": {
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "request_id", "retryable"],
      "properties": {
        "code": { "type": "string", "pattern": "^[A-Z0-9_]{3,64}$" },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "request_id": { "type": "string", "minLength": 8, "maxLength": 128 },
        "retryable": { "type": "boolean" },
        "details": { "type": "object", "additionalProperties": true }
      }
    }
  }
}

